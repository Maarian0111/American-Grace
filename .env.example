PORT=5000

# Optional Supabase (omit for local seed + data/local-db.json)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Reception auth — set these in Render / local .env (never commit real secrets)
# On Render/production: APP_PASSWORD is REQUIRED for the login gate to work.
# If unset on Render, the app shows setup instructions (no soft password).
# Local/dev only: if unset, soft-lock password is "american-grace" (logged at boot).
APP_PASSWORD=change-me-in-production
# Optional username gate (leave blank for password-only)
APP_USER=
# Optional cookie signing secret (defaults to APP_PASSWORD / soft-lock derivation)
SESSION_SECRET=
# Optional: force auth-required / setup messaging even outside Render (1 = on)
# AUTH_REQUIRED=1
