{
  "name": "american-grace",
  "version": "1.0.0",
  "description": "American Grace — boutique inventory & sales (local-first)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run build --prefix client",
